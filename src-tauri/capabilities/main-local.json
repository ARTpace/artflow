{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Only the local main webview may request user-mediated file dialogs, validated web links, its own process metrics, its own comic archive vault, the bundled declarative plugin descriptors, its own window controls, its own config volumes and the window lifecycle events those controls publish.",
  "local": true,
  "windows": ["main"],
  "webviews": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "allow-tauri-save-bytes",
    "allow-tauri-open-artflow",
    "allow-tauri-open-video-link",
    "allow-tauri-perf-metrics",
    "allow-tauri-comic-import",
    "allow-tauri-comic-get-page",
    "allow-tauri-list-declarative-plugins",
    "allow-tauri-restart-app",
    "allow-tauri-set-always-on-top",
    "allow-tauri-set-window-opacity",
    "allow-tauri-set-window-background",
    "allow-tauri-set-ignore-mouse-events",
    "allow-tauri-window-control",
    "allow-tauri-get-window-state",
    "allow-tauri-window-platform",
    "allow-tauri-window-move",
    "allow-tauri-config-read",
    "allow-tauri-config-write",
    "allow-tauri-config-stats",
    "allow-tauri-config-presets",
    "allow-tauri-config-storage",
    "allow-tauri-config-boot-log",
    "allow-tauri-config-boot-error",
    "allow-tauri-storage-choose-project",
    "allow-tauri-storage-status",
    "allow-tauri-storage-import-asset",
    "allow-tauri-storage-request-import",
    "allow-tauri-storage-get-import-job",
    "allow-tauri-storage-list-import-jobs",
    "allow-tauri-storage-cancel-import-job",
    "allow-tauri-storage-save-project",
    "allow-tauri-storage-load-project",
    "allow-tauri-storage-list-recent-projects",
    "allow-tauri-storage-open-recent-project",
    "allow-tauri-storage-clear-recent-projects",
    "allow-tauri-storage-query-viewport",
    "allow-tauri-storage-list-asset-inventory",
    "allow-tauri-storage-reclaim-assets",
    "allow-tauri-storage-request-preview",
    "allow-tauri-storage-get-preview-job",
    "allow-tauri-storage-cancel-preview-job",
    "allow-tauri-open-plugin-dir",
    "allow-tauri-open-panel-window",
    "allow-tauri-comfy-request",
    "allow-tauri-list-sandboxed-plugins",
    "allow-tauri-install-external-plugin",
    "allow-tauri-install-external-plugin-from-path",
    "allow-tauri-is-plugin-source-path",
    "allow-tauri-uninstall-external-plugin",
    "allow-tauri-invoke-sandboxed-plugin",
    "allow-tauri-read-plugin-clients",
    "allow-tauri-read-stored",
    "allow-tauri-read-plugin-page",
    "allow-tauri-sandbox-reply"
  ]
}
